# Read token — gated downloads (IndicTrans2, BPCC, FLORES). Safe to copy into
# notebooks and Kaggle Secrets.
HF_TOKEN=hf_your_read_token_here

# WRITE token — publishing weights ONLY. Kept separate from HF_TOKEN so a leak
# of the widely-copied read token cannot overwrite published weights
# (PLANNING.md 2026-08-10). scripts/push_restorer_hf.py refuses to fall back
# to HF_TOKEN.
HF_TOKEN_WRITE=hf_your_write_token_here
