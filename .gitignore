# --- secrets -----------------------------------------------------------------
# .env holds HF_TOKEN. BPCC and indictrans2-en-indic-1B are gated; a leaked
# token grants access under your account. Never commit it.
.env
.env.*
!.env.example
*.pem
*.key

# --- data --------------------------------------------------------------------
# PROJECT_NOTES.md §2.5: raw data and weights never go to git; large data stays local
# and is documented in data/README.md.
#
# data/raw/       BPCC TSVs + englishdev.csv, read-only inputs
# data/processed/ derived corpora (~286 MB); regenerate with data.fetch_bpcc
#                 + data.filter + data.leakage
# data/dev/       FLORES-200 is a GATED dataset -- redistributing it here would
#                 route around that gate. Fetch it yourself.
# Excluding the *contents* (dir/*) rather than the directory (dir/): git does
# not descend into an excluded directory, so a `!` negation inside one can never
# match and the folder would be missing entirely from a fresh clone.
data/raw/*
data/processed/*
data/dev/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/dev/.gitkeep
!data/README.md

# EXCEPTION, added 2026-08-16: the diacritic lexicon SHIPS.
# It is a required runtime input to the live-round pipeline, not a derived
# corpus — config/postproc_live.yaml names it, and with it absent the best
# system (sub 024, LB 15.05) silently degrades to sub 019's (13.99). It is
# 1.7 MB, so the "large data stays local" rule does not apply, and unlike the
# restorer weights there is no Hub fallback to fetch it from.
# Provenance is BPCC (CC-BY-4.0, attribution in NOTICE) + nawabhussain
# Kashmiri-Language-Corpus (Apache-2.0); both are already disclosed in
# MODEL_CARD.md §2. It contains word forms, not corpus text.
!data/processed/diacritic_lexicon_both.json

# Loose corpora anywhere
*.jsonl
*.tsv
!requirements-kaggle.txt

# --- model weights -----------------------------------------------------------
# Weights go to the HF Hub, not git (PROJECT_NOTES.md §2.5).
models/
checkpoints/
# Trainer output_dir (config/r3_*.yaml). The weight patterns below miss
# config.json, the tokenizer files and checkpoint-*/ state, which are not
# weights but still do not belong in git.
output/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
adapter_model/
lora/

